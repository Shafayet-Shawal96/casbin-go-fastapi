# Copy to .env and replace every value before running.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=rbac
MYSQL_USER=rbac
MYSQL_PASSWORD=change-me-db

# Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
INTERNAL_TOKEN=change-me-internal-token

# The only way to create a system-admin is `cmd/seed`, using these values.
SYSTEM_ADMIN_EMAIL=sysadmin@example.com
SYSTEM_ADMIN_PASSWORD=change-me-system-admin

# Set to true when serving the app over HTTPS.
COOKIE_SECURE=false
